{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(uv run:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(python scripts/*)",
      "Bash(curl http://localhost:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(python3 scripts/slot.py:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker compose down -v:*)",
      "Bash(curl https://*)",
      "Bash(alembic downgrade:*)",
      "Bash(python3 scripts/probe_models.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(cat .env*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/slot.py --brief || true"
          }
        ]
      }
    ]
  }
}