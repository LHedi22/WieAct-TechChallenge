# Copy to .env and fill in. NEVER commit .env. Never paste the key in chats, screenshots or videos.

# --- LLM provider ---
# local = Ollama on this machine (dev only) · cloud = EdNova platform (our slot only)
# mock = mock-llm · auto = cloud while our slot is live and the key works, otherwise local
# Production (APP_ENV=production) accepts only cloud.
# switch with python scripts/llm.py use … once M1 is done
LLM_PROVIDER=mock

# Cloud profile — the EdNova platform (key name: hack-04)
CLOUD_BASE_URL=https://llm.felcloud.io/v1
# Paste the hack-04 key here, in .env only. Never in code, chats, screenshots or videos.
CLOUD_API_KEY=
# Filled in from `python3 scripts/probe_models.py --provider cloud` (run it during your slot)
CLOUD_MODEL_COMPACT=pending-probe
CLOUD_MODEL_MID=pending-probe
CLOUD_EMBEDDING_MODEL=pending-probe
CLOUD_EMBEDDING_DIM=1024

# Local profile — Ollama on the host, dev only (docker: http://host.docker.internal:11434/v1)
LOCAL_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key; the OpenAI SDK needs a non-empty value
LOCAL_API_KEY=ollama
LOCAL_MODEL_COMPACT=qwen3:1.7b
# qwen3:8b fits our dev laptop (15.4 GB RAM); use qwen3:14b with 16 GB RAM or more
LOCAL_MODEL_MID=qwen3:8b
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_EMBEDDING_DIM=1024

# Mock profile — mock-llm/ (docker-compose), used by tests
MOCK_BASE_URL=http://localhost:9000/v1
MOCK_API_KEY=mock
MOCK_MODEL_COMPACT=mock-compact
MOCK_MODEL_MID=mock-mid
MOCK_EMBEDDING_MODEL=mock-embed
MOCK_EMBEDDING_DIM=384

# Shared by every provider
# Extra body for Qwen3-style models so they don't spend CPU time "thinking" (probe tells you)
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_S=90
LLM_MAX_RPM=18
LLM_MAX_CONCURRENCY=2
LLM_MAX_TOKENS_DEFAULT=700
# A or B — our alternating time-slot group (Tunis time)
LLM_SLOT_GROUP=A
# auto | on | off — response_format=json_object (auto: try it, drop it for a model on a 400)
LLM_JSON_MODE=auto
# Dev/test only (ignored in production): force the slot live|off to exercise LLM_PROVIDER=auto
LLM_SLOT_FORCE=

# --- Vector store: Qdrant (one collection; world/course/chapter as payload filters) ---
# Local dev: the docker-compose qdrant service. In-slot / prod: the platform's Qdrant if exposed,
# otherwise our hosted Qdrant (declared service).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Collection = {prefix}-{provider}-{embedding model slug}, sized by that profile's *_EMBEDDING_DIM
QDRANT_COLLECTION_PREFIX=hack-04-chunks

# --- App ---
# development | production (production allows only LLM_PROVIDER=cloud)
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://lw:lw@localhost:5432/learningworld
SECRET_KEY=change-me-in-.env
APP_TIMEZONE=Africa/Tunis
CORS_ORIGINS=http://localhost:5173
# auto: offline demo mode when outside our slot; on/off to force
OFFLINE_DEMO_MODE=auto
LOG_PROMPTS=false
UPLOAD_MAX_MB=50
TESSERACT_LANGS=ara+fra+eng
# Optional: if set, /api/admin/stats requires the header X-Admin-Token
ADMIN_TOKEN=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
