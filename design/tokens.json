{
  "$comment": "Source of truth for the Tailwind theme. *-ink variants are AA-safe (>=4.5:1) shades for text or for white text on top; base colors are for fills, icons and large text only.",
  "color": {
    "whitewash": "#FAF7F2",
    "sand": { "DEFAULT": "#E9D8B4", "dark": "#D9C291" },
    "ink": "#1E2A38",
    "primary": { "DEFAULT": "#1F5FA8", "light": "#4A82C4", "dark": "#174A84" },
    "sea": { "DEFAULT": "#3BA3C7", "ink": "#1B7598", "light": "#8FD0E6", "foam": "#D6F0F8" },
    "terracotta": { "DEFAULT": "#C8653A", "ink": "#A9502A", "light": "#E39A73" },
    "olive": { "DEFAULT": "#6B7F3A", "ink": "#5F7134", "light": "#A3B56B" },
    "danger": { "DEFAULT": "#C0443A" },
    "cat": "#E8892F",
    "bougainvillea": "#D6457E",
    "island": ["#1F5FA8", "#3BA3C7", "#C8653A", "#6B7F3A", "#8C5BB5", "#D6457E"]
  },
  "font": {
    "heading": ["\"Baloo Bhaijaan 2\"", "system-ui", "sans-serif"],
    "body": ["\"IBM Plex Sans Arabic\"", "system-ui", "sans-serif"]
  },
  "fontSize": {
    "display": ["64px", { "lineHeight": "1.1", "fontWeight": "600" }],
    "h1": ["40px", { "lineHeight": "1.15", "fontWeight": "600" }],
    "h2": ["28px", { "lineHeight": "1.2", "fontWeight": "600" }],
    "h3": ["20px", { "lineHeight": "1.3", "fontWeight": "600" }],
    "body": ["16px", { "lineHeight": "1.5" }],
    "small": ["13px", { "lineHeight": "1.4" }]
  },
  "radius": { "soft": "8px", "pixelStep": "2px" },
  "shadow": {
    "lip": "0 4px 0 0 rgba(30,42,56,0.9)",
    "lipPressed": "inset 0 2px 0 0 rgba(30,42,56,0.6)",
    "panel": "0 0 0 2px #1E2A38"
  },
  "layout": { "desktop": [1440, 900], "sidePanel": 340, "topBar": 64, "mobileBreakpoint": 768 },
  "motion": { "sailMs": 600, "pressMs": 80, "waterTileMs": 4000 }
}
